# ==== AI Provider ====
# UNZA Compass uses Anthropic's Claude API by default.
# Leave AI_API_KEY empty to run the app in FALLBACK mode (still fully demoable).
AI_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022

# ==== Database ====
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./unza_compass.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/unza_compass

# ==== Admin Account ====
ADMIN_EMAIL=admin@unzacompass.example
ADMIN_PASSWORD=ChangeThisPassword123!

# ==== Auth ====
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# ==== CORS ====
FRONTEND_URL=http://localhost:3000
